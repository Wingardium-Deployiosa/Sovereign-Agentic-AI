# Sovereign Voice Assistant - environment configuration
# Copy this file to .env and adjust paths.

WHISPER_MODEL_PATH=./models/whisper
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_LANGUAGE=en
WHISPER_BEAM_SIZE=1

VAD_MODEL_PATH=./models/silero
VAD_ENABLED=true
VAD_THRESHOLD=0.5
VAD_SILENCE_SECONDS=1.0
VAD_MIN_SPEECH_SECONDS=0.25
VAD_MAX_SPEECH_SECONDS=30.0

PIPER_MODEL_PATH=./models/piper
PIPER_CONFIG_PATH=./models/piper/onnx.json
PIPER_SPEAKER=0
PIPER_LENGTH_SCALE=1.0
TTS_ENABLED=true

BACKEND_URL=http://127.0.0.1:8000
BACKEND_TIMEOUT_SECONDS=60
SESSION_ID=session_001

SAMPLE_RATE=16000
CHANNELS=1
DTYPE=int16
RECORD_MAX_SECONDS=30
RECORD_FIXED_SECONDS=5

LOG_LEVEL=INFO